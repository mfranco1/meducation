// Tight electronic kick: sine with a fast pitch drop and a short click. Original patch for sfizz built-in oscillators.
<global>
ampeg_attack=0.001 ampeg_decay=0.3 ampeg_sustain=0 ampeg_release=0.08 amp_veltrack=60
<region> sample=*sine pitcheg_decay=0.07 pitcheg_sustain=0 pitcheg_depth=3000
<region> sample=*noise volume=-14 fil_type=lpf_2p cutoff=3000 ampeg_decay=0.02 ampeg_sustain=0
