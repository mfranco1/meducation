# Development-only local configuration. Copy to ops/containers/.env.
# These values must never be used as hosted/production credentials.
MEDUCATION_FRONTEND_PORT=4173
MEDUCATION_POSTGRES_PORT=5433
MEDUCATION_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-disposable-local-password
# DB mode override only; use service hostname postgres inside containers.
# MEDUCATION_DATABASE_URL=postgresql+psycopg://meducation_reader:REPLACE_READER_PASSWORD@postgres:5432/meducation?sslmode=disable
# MEDUCATION_MIGRATION_DATABASE_URL=postgresql+psycopg://meducation_migrator:REPLACE_MIGRATOR_PASSWORD@postgres:5432/meducation?sslmode=disable
