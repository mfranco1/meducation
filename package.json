{
  "name": "meducation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint src scripts eslint.config.mjs vite.config.ts playwright.config.ts playwright.admin.config.ts && npm run check:architecture",
    "format:check": "prettier --check .prettierrc.json package.json eslint.config.mjs \"tsconfig*.json\" vite.config.ts \"playwright*.config.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{ts,mjs}\" src/shared/theme.ts",
    "pretest:e2e": "VITE_CONTENT_MAX_RETRIES=0 npm run build",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "validate:content": "tsx scripts/content/validate-question-bank.ts",
    "migrate:flashcard-bank:v1": "tsx scripts/migrations/migrate-flashcard-bank-v1.ts",
    "audit:explanations": "tsx scripts/content/audit-explanations.ts",
    "check:architecture": "node scripts/architecture/check-boundaries.mjs",
    "test:architecture": "node --test scripts/architecture/boundaries.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "embla-carousel-react": "^8.6.0",
    "katex": "^0.18.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.3",
    "vitest": "^5.0.3"
  }
}
