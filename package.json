{
  "name": "meducation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "build:learner": "vite build",
    "build:admin": "VITE_BUILD_ADMIN=true vite build",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "lint": "eslint src scripts e2e eslint.config.mjs vite.config.ts playwright.config.ts playwright.admin.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest:e2e": "VITE_CONTENT_MAX_RETRIES=0 npm run build:learner",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "validate:content": "tsx scripts/content/validate-paired-files.ts",
    "report:quiz-batch": "tsx scripts/content/quiz-batch-report.ts",
    "build:content-policy": "node scripts/content/build-authoring-policy.mjs",
    "hero:image": "node scripts/branding/heroImage.mjs",
    "icons": "tsx --tsconfig tsconfig.app.json scripts/branding/icons.ts"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "embla-carousel-react": "^8.6.0",
    "katex": "^0.18.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.6.0",
    "parse5": "8.1.1",
    "prettier": "^3.9.9",
    "remark-parse": "^11.0.0",
    "saxes": "^6.0.0",
    "sharp": "^0.34.5",
    "svgo": "^4.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "vite": "^7.1.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
