# Build-time retry settings; maximum retries are 0–5 and delays are capped at 30 seconds.
VITE_CONTENT_MAX_RETRIES=3
VITE_CONTENT_RETRY_BASE_DELAY_MS=1000
VITE_CONTENT_RETRY_MAX_DELAY_MS=8000
# Optional static admin is built separately; these are public build flags, never auth.
VITE_BUILD_ADMIN=false
VITE_ENABLE_LOCAL_ADMIN=false
VITE_ADMIN_SOURCE=http
VITE_JSON_FIXTURE_AUTHORING=false
# Public image origins, if approved; local image paths need no extra origins.
VITE_CONTENT_IMAGE_ORIGINS=
