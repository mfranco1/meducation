# Content API requires a PostgreSQL reader URL at startup. JSON service mode is retired.
MEDUCATION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DB jobs are explicit and local-only. Copy this file to ignored backend/.env.
# Default DB environment is production; only explicit local mode permits loopback/service non-TLS.
# MEDUCATION_DATABASE_ENVIRONMENT=local
# MEDUCATION_DATABASE_URL=postgresql+psycopg://meducation_reader:REPLACE_READER_PASSWORD@127.0.0.1:5433/meducation?sslmode=disable
# MEDUCATION_OPERATOR_DATABASE_URL=postgresql+psycopg://meducation_operator:REPLACE_OPERATOR_PASSWORD@127.0.0.1:5433/meducation?sslmode=disable
# MEDUCATION_MIGRATION_DATABASE_URL=postgresql+psycopg://meducation_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:5433/meducation?sslmode=disable
# MEDUCATION_BOOTSTRAP_DATABASE_URL=postgresql+psycopg://meducation_bootstrap:REPLACE_BOOTSTRAP_PASSWORD@127.0.0.1:5433/meducation?sslmode=disable
# Distinct passwords of at least 16 characters; URL-encode passwords in URLs.
# MEDUCATION_POSTGRES_MIGRATOR_PASSWORD=REPLACE_MIGRATOR_PASSWORD
# MEDUCATION_POSTGRES_READER_PASSWORD=REPLACE_READER_PASSWORD
# MEDUCATION_POSTGRES_BACKUP_PASSWORD=REPLACE_BACKUP_PASSWORD
# MEDUCATION_POSTGRES_OPERATOR_PASSWORD=REPLACE_OPERATOR_PASSWORD

# Optional local auth roles: supply BOTH distinct passwords to bootstrap.
# MEDUCATION_POSTGRES_SESSION_PASSWORD=REPLACE_DISTINCT_SESSION_PASSWORD
# MEDUCATION_POSTGRES_EDITOR_PASSWORD=REPLACE_DISTINCT_EDITOR_PASSWORD
# Admin remains disabled. Only a synthetic loopback issuer is currently supported;
# see docs/operations.md (Editor login and sessions) before enabling a local experiment.
MEDUCATION_ADMIN_ENABLED=false

# Hosted reader jobs must use production mode and verified TLS (no local bypass).
# MEDUCATION_DATABASE_ENVIRONMENT=production
# MEDUCATION_DATABASE_URL=postgresql+psycopg://meducation_reader:REPLACE_READER_PASSWORD@DB_HOST/DB_NAME?sslmode=verify-full
# No runtime owner/bootstrap/migrator/operator credentials. Inject job secrets separately.
# Optional admin configuration remains local-only; production adapter work is pending.
# MEDUCATION_ADMIN_ENVIRONMENT=local
# MEDUCATION_ADMIN_ADAPTER=synthetic
# MEDUCATION_ADMIN_ORIGIN=http://127.0.0.1:5173
# MEDUCATION_ADMIN_ISSUER=http://127.0.0.1:8001/fixture-issuer
# MEDUCATION_ADMIN_AUTHORIZATION_ENDPOINT=http://127.0.0.1:8001/fixture-issuer/authorize
# MEDUCATION_ADMIN_TOKEN_ENDPOINT=http://127.0.0.1:8001/fixture-issuer/token
# MEDUCATION_ADMIN_JWKS_URI=http://127.0.0.1:8001/fixture-issuer/jwks
# MEDUCATION_ADMIN_CLIENT_ID=REPLACE_CLIENT_ID
# MEDUCATION_ADMIN_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# MEDUCATION_ADMIN_EDITOR_SUBJECT=REPLACE_EXACT_ISSUER_SUBJECT
# MEDUCATION_ADMIN_EPOCH=REPLACE_NEW_RANDOM_EXTERNAL_EPOCH
# MEDUCATION_ADMIN_ENCRYPTION_KEY=REPLACE_FERNET_KEY
# MEDUCATION_ADMIN_SESSION_DATABASE_URL=postgresql+psycopg://meducation_session:REPLACE_SESSION_PASSWORD@127.0.0.1:5433/meducation?sslmode=disable
# MEDUCATION_ADMIN_EDITOR_DATABASE_URL=postgresql+psycopg://meducation_editor:REPLACE_EDITOR_PASSWORD@127.0.0.1:5433/meducation?sslmode=disable
